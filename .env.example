# NEUTRON MES AI Assistant — environment variables
# Copy to .env and fill in values (never commit .env)

# PostgreSQL async DSN (readonly MES bridge)
# IMPORTANT: replace host and port with real values — do not leave the word "port" literal
DATABASE_URL=postgresql+asyncpg://mes_readonly:YOUR_PASSWORD@your-db-host:5432/mes_db

# Optional overrides
# DEBUG=false
# DEFAULT_WORKSHOP_ID=WS-001
# DB_POOL_SIZE=5

# Alibaba Cloud Bailian (DashScope) — Intent Router (Feature 1.2)
DASHSCOPE_API_KEY=your_dashscope_api_key
BAILIAN_APP_ID=your_bailian_application_id
