# =============================================================================
# NEUTRON MES AI Assistant — production .env (Docker)
# =============================================================================
# 1. Copy this file on the server:  cp .env.example .env
# 2. Fill in the three REQUIRED values below (DATABASE_URL, DASHSCOPE, BAILIAN)
# 3. Deploy:  docker compose build api web && docker compose up -d
# 4. Prewarm cache:  docker compose exec api python scripts/refresh_dashboard_cache.py
#
# Never commit .env to git.
# =============================================================================

# --- REQUIRED: MES PostgreSQL (readonly) -----------------------------------

DATABASE_URL=postgresql+asyncpg://mes_readonly:YOUR_PASSWORD@your-db-host:5432/mes_db

# --- REQUIRED: Alibaba Cloud Bailian / DashScope (chat intent + synthesis) ---

DASHSCOPE_API_KEY=your_dashscope_api_key
BAILIAN_APP_ID=your_bailian_application_id

# --- Database pool (connection exhaustion fix) --------------------------------
# 0 = NullPool: open/close TCP per query (recommended when PG slots are scarce).
# Raise only after confirming MES max_connections headroom.

DB_POOL_SIZE=0
DB_MAX_OVERFLOW=0
DB_PG_WORK_CONCURRENCY=1

# --- Workshop context (HTTP header default; not a SQL line filter) ------------

DEFAULT_WORKSHOP_ID=WS-001

# --- Relative dates (今天 / today) --------------------------------------------
# Intent parsing and dashboard windows use the API container's local calendar date.
# Set TZ=Asia/Shanghai in docker-compose.yml if the host runs UTC but operators
# expect China local "today".

# --- Warehouse scope (optional) -----------------------------------------------
# Leave empty for all warehouses (global scope, cache key __all__).
# Set to a code (e.g. WH01) to scope warehouse/procurement dashboards only.

DEFAULT_WH_CODE=

# --- Dashboard SQLite cache (recommended for Docker) --------------------------
# Persists in Docker volume mesai_data → /app/data inside the api container.
# After deploy, run refresh_dashboard_cache.py once to prewarm __all__ scope.

DASHBOARD_CACHE_ENABLED=true
DASHBOARD_CACHE_DB_PATH=/app/data/dashboard_cache.db
DASHBOARD_CACHE_TTL_SECONDS=900
DASHBOARD_CACHE_STALE_OK=true
DASHBOARD_CACHE_REFRESH_INTERVAL_SECONDS=3600
DASHBOARD_CACHE_REFRESH_ON_STARTUP=false

# --- Chat history SQLite (optional persistence) -------------------------------

CHAT_DB_PATH=/app/data/chat_history.db

# --- RAG (knowledge retrieval) ------------------------------------------------

RAG_BACKEND=chroma
RAG_EMBEDDING_MODEL=text-embedding-v2
CHROMA_PERSIST_DIR=/app/data/chroma

# --- Voice (mock until real ASR is wired) -----------------------------------

VOICE_MOCK=true

# --- App tuning ---------------------------------------------------------------

DEBUG=false

# --- Docker Compose (read by docker-compose.yml on the host) ------------------
# These affect port mapping and base images, not the Python app directly.

MESAI_HTTP_PORT=80
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim-bookworm
NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine

# =============================================================================
# REMOVED (no longer used — do not set):
#   DEFAULT_LINE_ID   — dashboards default to global all-lines scope (__all__)
#   VITE_DEFAULT_LINE_ID — frontend no longer sends a default line_id
# =============================================================================
