# NEUTRON MES AI Assistant — environment variables
# Copy to .env and fill in values (never commit .env)

DATABASE_URL=postgresql+asyncpg://mes_readonly:YOUR_PASSWORD@your-db-host:5432/mes_db

# DEBUG=false
# DEFAULT_WORKSHOP_ID=WS-001
# DB_POOL_SIZE=5

# Alibaba Cloud Bailian (DashScope)
DASHSCOPE_API_KEY=your_dashscope_api_key
BAILIAN_APP_ID=your_bailian_application_id

# RAG (v0.3)
# RAG_BACKEND=chroma   # pgvector | chroma | file (default: chroma → file fallback)
# RAG_EMBEDDING_MODEL=text-embedding-v2
# CHROMA_PERSIST_DIR=./data/chroma

# Voice (v0.3)
# VOICE_MOCK=true
